// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  password                    String?
  provider                    String?
  providerId                  String?
  name                        String?
  avatarUrl                   String?
  bio                         String?   @db.Text
  plan                        String    @default("free")
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  isVerified                  Boolean   @default(false)
  verificationToken           String?   @unique
  verificationTokenExpiresAt  DateTime?
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?
  twoFactorSecret             String?
  twoFactorEnabled            Boolean   @default(false)
  failedLoginAttempts         Int       @default(0)
  lockedUntil                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  notes              Note[]
  folders            Folder[]
  tags               Tag[]
  noteOrders         NoteOrder[]
  collaborations     NoteCollaborator[]
  notePreferences    UserNotePreference[]
  userNoteTags       UserNoteTag[]
  feedback           Feedback?
  bugReports         BugReport[]
  reflections        Reflection[]
  publishedNotes     PublishedNote[]
  following          Follow[]             @relation("UserFollowing")
  followers          Follow[]             @relation("UserFollowers")
  notifications      Notification[]

  @@unique([provider, providerId])
}

model Folder {
  id        String   @id @default(uuid())
  name       String
  color      String?  @default("#10b981") // Grüner Akzent
  icon       String?
  coverImage String?  // Space cover for the Home dashboard
  order      Int      @default(0) // Manual sort order on the Home dashboard
  parentId   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("SubFolders")
  notes     Note[]

  @@index([userId])
  @@index([parentId])
}

model Note {
  id          String   @id @default(uuid())
  title       String?  @db.Text
  content     String   @db.Text
  coverImage  String?  // Note cover for the Home dashboard ("Continue Thinking")
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  order       Int      @default(0)
  folderId    String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteTags        NoteTag[]
  attachments     Attachment[]
  collaborators   NoteCollaborator[]
  notePreferences UserNotePreference[]
  userNoteTags    UserNoteTag[]
  versions        NoteVersion[]
  publishedNote   PublishedNote?

  @@index([userId])
  @@index([folderId])
  @@index([isPinned])
  @@index([isFavorite])
  @@index([isArchived])
  @@index([isDeleted])
  @@index([order])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#10b981")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags     NoteTag[]
  userNoteTags UserNoteTag[]

  @@unique([name, userId])
  @@index([userId])
}

model NoteTag {
  noteId    String
  tagId     String
  createdAt DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  fileType  String
  fileSize  Int
  url       String
  noteId    String
  createdAt DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model NoteCollaborator {
  id          String    @id @default(uuid())
  noteId      String
  userId      String
  role        String    @default("editor")
  status      String    @default("pending")
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?

  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@index([noteId])
  @@map("note_collaborators")
}

model UserNotePreference {
  id                String   @id @default(uuid())
  noteId            String
  userId            String
  isPinned          Boolean?
  isFavorite        Boolean?
  folderId          String?
  folderOverrideSet Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("user_note_preferences")
}

model UserNoteTag {
  noteId    String
  tagId     String
  userId    String
  createdAt DateTime @default(now())

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId, userId])
  @@index([noteId, userId])
  @@map("user_note_tags")
}

model NoteVersion {
  id        String   @id @default(uuid())
  noteId    String
  content   String   @db.Text
  title     String?  @db.Text
  createdAt DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_versions")
}

model NoteOrder {
  id          String   @id @default(uuid())
  noteId      String
  userId      String
  contextType String   // 'all', 'folder', 'tag', 'favorites', 'archive'
  contextId   String   @default("_none") // folder-id oder tag-id, "_none" für all/favorites/archive
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, contextType, contextId])
  @@index([userId, contextType, contextId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @unique
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reflection {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.Text
  content   String   @db.Text
  date      DateTime @db.Date // one entry per calendar day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// A note made public for Browse. Snapshot model: title/content/excerpt/readingTime
// are frozen at publish time and only refreshed on an explicit "Update publication",
// so private edits never leak. Copying a published note clones it without any link.
model PublishedNote {
  id          String   @id @default(uuid())
  noteId      String   @unique
  ownerId     String
  title       String?  @db.Text
  description String?  @db.Text
  content     String   @db.Text // frozen snapshot of the note body at publish time
  coverImage  String?
  tags        String[]
  topics      String[]
  readingTime Int      @default(1) // minutes, derived from the snapshot
  visibility  String   @default("public")
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([publishedAt])
  @@index([visibility])
  @@map("published_notes")
}

// Directed follow: followerId follows followingId. Immediate, no approval (public
// discovery, not a private social graph). One row per (follower, following) pair.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Generic notification feed for the bell. `data` holds a type-specific snapshot so
// the bell can render without extra joins (e.g. { collaboratorId, noteId, noteTitle,
// fromName } for collab_invite; { followerId, name, avatarUrl } for new_follower).
model Notification {
  id        String   @id @default(uuid())
  userId    String // recipient
  type      String // 'collab_invite' | 'new_follower'
  data      Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}
