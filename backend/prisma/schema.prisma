// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm backs the GIN indexes that make ILIKE '%q%' searches index-assisted.
  extensions = [pg_trgm]
}

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  password                    String?
  provider                    String?
  providerId                  String?
  name                        String?
  username                    String?   @unique
  avatarUrl                   String?
  bio                         String?   @db.Text
  plan                        String    @default("free")
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  isVerified                  Boolean   @default(false)
  verificationToken           String?   @unique
  verificationTokenExpiresAt  DateTime?
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?
  twoFactorSecret             String?
  twoFactorEnabled            Boolean   @default(false)
  failedLoginAttempts         Int       @default(0)
  lockedUntil                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  notes             Note[]
  spaces            Space[]
  folders           Folder[]
  bookmarks         Bookmark[]
  noteOrders        NoteOrder[]
  collaborations    NoteCollaborator[]
  notePreferences   UserNotePreference[]
  userNoteBookmarks UserNoteBookmark[]
  feedback          Feedback?
  bugReports        BugReport[]
  reflections       Reflection[]
  publishedNotes    PublishedNote[]
  following         Follow[]             @relation("UserFollowing")
  followers         Follow[]             @relation("UserFollowers")
  notifications     Notification[]
  publishedLikes    PublishedNoteLike[]
  reminders         Reminder[]

  @@unique([provider, providerId])
  // People search matches name/username with contains — trgm makes that indexed.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Top-level container on the Home dashboard. Holds folders and notes directly.
model Space {
  id         String   @id @default(uuid())
  name       String
  color      String?  @default("#10b981")
  icon       String?
  coverImage String?
  isPinned   Boolean  @default(false)
  order      Int      @default(0)
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders Folder[]
  notes   Note[]

  @@index([userId])
}

// Lives inside a space; can nest into other folders (recursive).
model Folder {
  id         String   @id @default(uuid())
  name       String
  color      String?  @default("#10b981") // Grüner Akzent
  icon       String?
  coverImage String? // Folder cover for the Home dashboard
  isPinned   Boolean  @default(false) // Pinned folders surface first
  order      Int      @default(0) // Manual sort order
  spaceId    String
  parentId   String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("SubFolders")
  notes    Note[]

  @@index([userId])
  @@index([spaceId])
  @@index([parentId])
}

model Note {
  id         String    @id @default(uuid())
  title      String?   @db.Text
  content    String    @db.Text
  coverImage String? // Note cover for the Home dashboard ("Continue Thinking")
  isPinned   Boolean   @default(false)
  isLocked   Boolean   @default(false)
  isFavorite Boolean   @default(false)
  isArchived Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  order      Int       @default(0)
  spaceId    String?
  folderId   String?
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // when the note was trashed; drives the 30-day auto-purge
  // Persisted Yjs document state. Loaded when the first client joins a collab
  // session, so joiners never see an empty doc (client-side seeding raced when
  // two clients joined an empty doc simultaneously → split-brain).
  yjsState   Bytes?

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  space             Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  folder            Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteBookmarks     NoteBookmark[]
  attachments       Attachment[]
  collaborators     NoteCollaborator[]
  notePreferences   UserNotePreference[]
  userNoteBookmarks UserNoteBookmark[]
  versions          NoteVersion[]
  publishedNote     PublishedNote?
  reminders         Reminder[]

  // Matches the list query exactly (userId filter + pinned-first/recency sort);
  // its prefix also serves every plain userId lookup. Single-column boolean
  // indexes were dropped: too unselective for the planner, but every autosave
  // had to maintain them.
  @@index([userId, isPinned(sort: Desc), updatedAt(sort: Desc)])
  @@index([spaceId])
  @@index([folderId])
  // Hourly trash purge scans for expired rows.
  @@index([isDeleted, deletedAt])
  // In-note search is ILIKE '%q%' — trgm keeps it indexed as content grows.
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Bookmark {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#10b981")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteBookmarks     NoteBookmark[]
  userNoteBookmarks UserNoteBookmark[]

  @@unique([name, userId])
  @@index([userId])
}

model NoteBookmark {
  noteId     String
  bookmarkId String
  createdAt  DateTime @default(now())

  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@id([noteId, bookmarkId])
  @@index([noteId])
  @@index([bookmarkId])
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  fileType  String
  fileSize  Int
  url       String
  noteId    String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model NoteCollaborator {
  id         String    @id @default(uuid())
  noteId     String
  userId     String
  role       String    @default("editor")
  status     String    @default("pending")
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@index([noteId])
  @@map("note_collaborators")
}

model UserNotePreference {
  id                String   @id @default(uuid())
  noteId            String
  userId            String
  isPinned          Boolean?
  isFavorite        Boolean?
  folderId          String?
  folderOverrideSet Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("user_note_preferences")
}

model UserNoteBookmark {
  noteId     String
  bookmarkId String
  userId     String
  createdAt  DateTime @default(now())

  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, bookmarkId, userId])
  @@index([noteId, userId])
  @@map("user_note_bookmarks")
}

model NoteVersion {
  id        String   @id @default(uuid())
  noteId    String
  content   String   @db.Text
  title     String?  @db.Text
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_versions")
}

model NoteOrder {
  id          String   @id @default(uuid())
  noteId      String
  userId      String
  contextType String // 'all', 'folder', 'tag', 'favorites', 'archive'
  contextId   String   @default("_none") // folder-id oder tag-id, "_none" für all/favorites/archive
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, contextType, contextId])
  @@index([userId, contextType, contextId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @unique
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reflection {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.Text
  content   String   @db.Text
  date      DateTime @db.Date // one entry per calendar day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// A note made public for Explore. Snapshot model: title/content/excerpt/readingTime
// are frozen at publish time and only refreshed on an explicit "Update publication",
// so private edits never leak. Copying a published note clones it without any link.
model PublishedNote {
  id          String   @id @default(uuid())
  noteId      String   @unique
  ownerId     String
  title       String?  @db.Text
  description String?  @db.Text
  content     String   @db.Text // frozen snapshot of the note body at publish time
  coverImage  String?
  tags        String[]
  topics      String[]
  readingTime Int      @default(1) // minutes, derived from the snapshot
  visibility  String   @default("public")
  viewCount   Int      @default(0)
  likeCount   Int      @default(0) // denormalized total, kept in sync on like toggle
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  note  Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
  likes PublishedNoteLike[]

  @@index([ownerId])
  @@index([publishedAt])
  @@index([visibility])
  @@index([likeCount])
  // Explore search: contains on title/content (trgm) and has-filters on the arrays.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
  @@index([topics], type: Gin)
  @@map("published_notes")
}

// One like per user per published note. PublishedNote.likeCount is the denormalized
// total kept in sync on toggle (so trending can sort without a join).
model PublishedNoteLike {
  id              String   @id @default(uuid())
  userId          String
  publishedNoteId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedNote PublishedNote @relation(fields: [publishedNoteId], references: [id], onDelete: Cascade)

  @@unique([userId, publishedNoteId])
  @@index([userId])
  @@index([publishedNoteId])
  // Trending groups the recent like window by note.
  @@index([createdAt])
  @@map("published_note_likes")
}

// Directed follow: followerId follows followingId. Immediate, no approval (public
// discovery, not a private social graph). One row per (follower, following) pair.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Generic notification feed for the bell. `data` holds a type-specific snapshot so
// the bell can render without extra joins (e.g. { collaboratorId, noteId, noteTitle,
// fromName } for collab_invite; { followerId, name, avatarUrl } for new_follower).
model Notification {
  id        String   @id @default(uuid())
  userId    String // recipient
  type      String // 'collab_invite' | 'collab_accepted' | 'new_follower' | 'note_like' | 'reminder'
  data      Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// User-set reminder tied to a note. A background poller (index.ts) fires due rows:
// it creates a 'reminder' notification + sends an email, then either deletes a
// one-off or rolls `remindAt` forward to the next occurrence for a recurring one.
model Reminder {
  id          String   @id @default(uuid())
  userId      String // recipient
  noteId      String
  description String   @db.Text
  remindAt    DateTime
  recurrence  String   @default("none") // 'none' | 'daily' | 'weekly' | 'monthly'
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([remindAt]) // poller scans for due rows
  @@index([userId, noteId])
  @@map("reminders")
}
