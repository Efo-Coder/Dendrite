# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dendrite_notes

# JWT
JWT_SECRET=dein-sicheres-secret-mindestens-32-zeichen
JWT_EXPIRES_IN=7d

# Server
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (E-Mail-Versand)
SMTP_HOST=smtp.beispiel.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine@email.de
SMTP_PASS=dein-smtp-passwort
SMTP_FROM=Dendrite <noreply@dendrite.app>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WRITER=price_...
STRIPE_PRICE_AUTHOR=price_...
